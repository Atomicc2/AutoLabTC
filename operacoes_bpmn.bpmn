        <di:waypoint x="415" y="630" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Size_Yes_di" bpmnElement="Flow_Size_Yes">
        <di:waypoint x="440" y="605" />
