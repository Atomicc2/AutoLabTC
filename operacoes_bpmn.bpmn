        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Size_No_di" bpmnElement="Flow_Size_No">
        <di:waypoint x="465" y="630" />
        <di:waypoint x="520" y="630" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="482" y="612" width="21" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
