<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn.io" exporterVersion="17.0.2">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Frontend" name="Frontend (React)" processRef="Process_Frontend" />
    <bpmn:participant id="Participant_Backend" name="Backend (FastAPI)" processRef="Process_Backend" />
    <bpmn:messageFlow id="MessageFlow_Upload" name="POST /operacoes/{nome} + multipart .jff" sourceRef="Task_SubmitRequest" targetRef="StartEvent_ReceiveRequest" />
    <bpmn:messageFlow id="MessageFlow_Download" name="XML .jff download (attachment)" sourceRef="Task_ReturnResponse" targetRef="Task_DownloadFile" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Frontend" isExecutable="false">
    <bpmn:startEvent id="StartEvent_UserAction" name="Usuário seleciona arquivo .jff e operação">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SubmitRequest" name="Enviar requisição (FormData: arquivo)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DownloadFile" name="Baixar arquivo modificado">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_SuccessFrontend" name="Operação concluída (download)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_UserAction" targetRef="Task_SubmitRequest" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_SubmitRequest" targetRef="Task_DownloadFile" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_DownloadFile" targetRef="EndEvent_SuccessFrontend" />
  </bpmn:process>
  <bpmn:process id="Process_Backend" isExecutable="false">
    <bpmn:startEvent id="StartEvent_ReceiveRequest" name="Receber requisição">
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_OpExists" name="Operação existe em OPERACOES?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_OpExists_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_OpExists_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ThrowOpNotFound" name="Lançar OperacaoNaoEncontradaError (404)">
      <bpmn:incoming>Flow_OpExists_No</bpmn:incoming>
      <bpmn:outgoing>Flow_ToError</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Extension" name="Extensão .jff válida?">
      <bpmn:incoming>Flow_OpExists_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Ext_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ext_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ThrowInvalidExt" name="Lançar ArquivoInvalidoError (400)">
      <bpmn:incoming>Flow_Ext_No</bpmn:incoming>
      <bpmn:outgoing>Flow_ToError</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReadContent" name="Ler conteúdo do arquivo (await arquivo.read())">
      <bpmn:incoming>Flow_Ext_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Size" name="Tamanho &lt;= 1MB?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Size_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Size_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ThrowTooLarge" name="Lançar ArquivoInvalidoError (400)">
      <bpmn:incoming>Flow_Size_No</bpmn:incoming>
      <bpmn:outgoing>Flow_ToError</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ParseJFF" name="Parsear .jff: UtilitarioJff.ler(conteudo)">
      <bpmn:incoming>Flow_Size_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ParseValid" name="XML válido e estrutura correta?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Parse_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Parse_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ThrowInvalidJFF" name="Lançar ArquivoInvalidoError (400)">
      <bpmn:incoming>Flow_Parse_No</bpmn:incoming>
      <bpmn:outgoing>Flow_ToError</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ExecuteOp" name="Executar operação: OPERACOES[nome](automato)">
      <bpmn:incoming>Flow_Parse_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_OpValid" name="Operação válida (ex.: AFD para complemento)?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_OpValid_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_OpValid_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ThrowOpInvalid" name="Lançar OperacaoInvalidaError (422)">
      <bpmn:incoming>Flow_OpValid_No</bpmn:incoming>
      <bpmn:outgoing>Flow_ToError</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SerializeJFF" name="Serializar resultado: UtilitarioJff.escrever(resultado)">
      <bpmn:incoming>Flow_OpValid_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReturnResponse" name="Retornar Response (application/xml + Content-Disposition)">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Success" name="Sucesso: arquivo .jff retornado">
      <bpmn:incoming>Flow_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_ErrorHandler" name="Tratamento de erros (exception handler)">
      <bpmn:incoming>Flow_ToError</bpmn:incoming>
      <bpmn:outgoing>Flow_ToErrorEnd</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_ErrorSub" name="Erro de domínio lançado">
        <bpmn:outgoing>Flow_E1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_MapError" name="Mapear ErroDeDominio.status/mensagem">
        <bpmn:incoming>Flow_E1</bpmn:incoming>
        <bpmn:outgoing>Flow_E2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="EndEvent_ErrorJSON" name="Retornar JSON error">
        <bpmn:incoming>Flow_E2</bpmn:incoming>
        <bpmn:messageEventDefinition id="MessageEventDefinition_2" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_E1" sourceRef="StartEvent_ErrorSub" targetRef="Task_MapError" />
      <bpmn:sequenceFlow id="Flow_E2" sourceRef="Task_MapError" targetRef="EndEvent_ErrorJSON" />
    </bpmn:subProcess>
    <bpmn:endEvent id="EndEvent_Error" name="Resposta de erro enviada">
      <bpmn:incoming>Flow_ToErrorEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="StartEvent_ReceiveRequest" targetRef="Gateway_OpExists" />
    <bpmn:sequenceFlow id="Flow_OpExists_Yes" name="Sim" sourceRef="Gateway_OpExists" targetRef="Gateway_Extension" />
    <bpmn:sequenceFlow id="Flow_OpExists_No" name="Não" sourceRef="Gateway_OpExists" targetRef="Task_ThrowOpNotFound" />
    <bpmn:sequenceFlow id="Flow_Ext_Yes" name="Sim" sourceRef="Gateway_Extension" targetRef="Task_ReadContent" />
    <bpmn:sequenceFlow id="Flow_Ext_No" name="Não" sourceRef="Gateway_Extension" targetRef="Task_ThrowInvalidExt" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ReadContent" targetRef="Gateway_Size" />
    <bpmn:sequenceFlow id="Flow_Size_Yes" name="Sim" sourceRef="Gateway_Size" targetRef="Task_ParseJFF" />
    <bpmn:sequenceFlow id="Flow_Size_No" name="Não" sourceRef="Gateway_Size" targetRef="Task_ThrowTooLarge" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ParseJFF" targetRef="Gateway_ParseValid" />
    <bpmn:sequenceFlow id="Flow_Parse_Yes" name="Sim" sourceRef="Gateway_ParseValid" targetRef="Task_ExecuteOp" />
    <bpmn:sequenceFlow id="Flow_Parse_No" name="Não" sourceRef="Gateway_ParseValid" targetRef="Task_ThrowInvalidJFF" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ExecuteOp" targetRef="Gateway_OpValid" />
    <bpmn:sequenceFlow id="Flow_OpValid_Yes" name="Sim" sourceRef="Gateway_OpValid" targetRef="Task_SerializeJFF" />
    <bpmn:sequenceFlow id="Flow_OpValid_No" name="Não" sourceRef="Gateway_OpValid" targetRef="Task_ThrowOpInvalid" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_SerializeJFF" targetRef="Task_ReturnResponse" />
    <bpmn:sequenceFlow id="Flow_ToEnd" sourceRef="Task_ReturnResponse" targetRef="EndEvent_Success" />
    <bpmn:sequenceFlow id="Flow_ToError" sourceRef="Task_ThrowOpNotFound" targetRef="SubProcess_ErrorHandler" />
    <bpmn:sequenceFlow id="Flow_ToError" sourceRef="Task_ThrowInvalidExt" targetRef="SubProcess_ErrorHandler" />
    <bpmn:sequenceFlow id="Flow_ToError" sourceRef="Task_ThrowTooLarge" targetRef="SubProcess_ErrorHandler" />
    <bpmn:sequenceFlow id="Flow_ToError" sourceRef="Task_ThrowInvalidJFF" targetRef="SubProcess_ErrorHandler" />
    <bpmn:sequenceFlow id="Flow_ToError" sourceRef="Task_ThrowOpInvalid" targetRef="SubProcess_ErrorHandler" />
    <bpmn:sequenceFlow id="Flow_ToErrorEnd" sourceRef="SubProcess_ErrorHandler" targetRef="EndEvent_Error" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Frontend_di" bpmnElement="Participant_Frontend" isHorizontal="true">
